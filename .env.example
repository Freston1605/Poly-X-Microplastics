# Poly-X runtime knobs. Copy to `.env` and adjust as needed.
# The installer (SETUP.bat) never creates .env; the app runs fine without it.

# Interface language: "es" (default) or "en".
POLYX_IDIOMA=

# Theme override: oscuro, claro, sepia, blueprint.
POLYX_TEMA=

# Set to any non-empty value to disable UI animations.
POLYX_SIN_ANIMACION=

# Observability: log directory, level (debug|info|warning|error) and the cap
# on the total size of the rotating logs. Defaults: stdout, level info.
POLYX_LOG_DIR=
POLYX_LOG=
POLYX_LOG_TOTAL_CAP_MB=
