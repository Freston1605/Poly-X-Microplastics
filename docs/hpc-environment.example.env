# Placeholder for cluster-specific values. Copy to .env.hpc (gitignored) on the
# cluster and fill it in there. Never commit real values, usernames, tokens,
# keys or absolute personal paths.
#
# Account and partition used for job submission.
POLYX_HPC_ACCOUNT=
POLYX_HPC_PARTITION=

# Work and scratch directories on the cluster filesystem.
POLYX_HPC_WORK=
POLYX_HPC_SCRATCH=

# Base URL that serves the published weights. The manifest in weights.sha256
# pins the digest of every file; the URL alone is never trusted.
POLYX_WEIGHTS_URL=

# User data location consumed by the existing path module.
POLYX_HOME=
