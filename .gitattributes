# Line endings and binary handling by file type.
#
# The project is developed on Linux and Windows with core.autocrlf=true, and a
# shell script with CRLF reaches bash as a confusing error that looks like a
# permissions or interpreter problem:
#
#     /bin/bash^M: bad interpreter: No such file or directory
#
# Let git decide and normalise to LF inside the repository.

* text=auto

# ── POSIX shell: always LF ──
# Not negotiable: with CRLF they do not start.
*.sh       text eol=lf

# ── Windows batch: CRLF ──
# cmd.exe misreads LF inside labels and GOTO jumps.
*.bat      text eol=crlf

# ── Binaries: git leaves the bytes alone ──
*.pt       binary
*.onnx     binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
*.icns     binary
*.pdf      binary
*.zip      binary
*.rar      binary
